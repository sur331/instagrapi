import os
import time
import random
from flask import Flask
from threading import Thread
from instagrapi import Client

app = Flask(__name__)

@app.route('/')
def home():
    return "Instagram Auto-Liker is running active!"

def run_web():
    # طلب استخدام المنفذ المحدد في البيئة أو 8080 كافتراضي
    port = int(os.environ.get("PORT", 8080))
    app.run(host='0.0.0.0', port=port)

# قائمة الحسابات المراد استخدامها
ACCOUNTS = [
    {"username": "realestate_surr", "password": "suR_1212"},
    {"username": "surcityonan", "password": "suR_1212"},
]

# رابط المنشور المطلوب الإعجاب به
TARGET_POST_URL = "https://www.instagram.com/reel/DbaaMdINxVu/?igsh=MThqMWE3Y2JoaTA5ZQ=="

def perform_likes():
    # الانتظار بضع ثوانٍ لضمان بدء تشغيل Web Server
    time.sleep(10)
    print("⏳ بدأ تنفيذ عملية الإعجابات...")

    for acc in ACCOUNTS:
        username = acc["username"]
        password = acc["password"]

        cl = Client()
        session_file = f"session_{username}.json"

        try:
            print(f"🔑 جاري تسجيل الدخول للحساب: {username}")

            # محاولة تحميل الجلسة السابقة لتجنب حظر الدخول
            if os.path.exists(session_file):
                cl.load_settings(session_file)
                cl.login(username, password)
            else:
                cl.login(username, password)
                cl.dump_settings(session_file)

            # جلب معرف المنشور من الرابط (تم تصحيح اسم الدالة هنا)
            media_pk = cl.media_pk_from_url(TARGET_POST_URL)

            # وضع الإعجاب
            cl.media_like(media_pk)
            print(f"✅ تم وضع إعجاب بنجاح بواسطة: {username}")

        except Exception as e:
            print(f"❌ حدث خطأ أثناء معالجة الحساب {username}: {e}")

        # انتظار عشوائي بين الحسابات لتجنب كشف البوت (بين 5 إلى 15 ثانية)
        time.sleep(random.randint(5, 15))

if __name__ == "__main__":
    # تشغيل خادم Flask في مسار منفصل (Thread)
    t = Thread(target=run_web)
    t.start()

    # بدء تنفيذ الإعجابات
    perform_likes()
